# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Replace <username>, <password>, and <cluster> with your actual Atlas credentials.
# For local development: mongodb://localhost:27017/audit-trail
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/audit-trail?retryWrites=true&w=majority

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Origin(s) allowed to hit the API.
# Comma-separate multiple origins: http://localhost:3000,https://app.example.com
CLIENT_ORIGIN=http://localhost:3000
